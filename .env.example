# Copy to .env and fill in. Never commit .env.
# Every setting is documented in app/config.py.

# --- Server -----------------------------------------------------------------
ENVIRONMENT=production
# Your domain (DNS A record must point at the server). Caddy gets HTTPS for it automatically.
DOMAIN=tolk.example.uz
# Public URL of the app; Telegram opens this as the Mini App. Must be https.
TOLK_WEBAPP_URL=https://tolk.example.uz

# --- Telegram ---------------------------------------------------------------
# From @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Bot username without "@" (used for the Login Widget and t.me links)
TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram user IDs that become admins on sign-in (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=

# --- Database (docker-compose builds DATABASE_URL from these) -----------------
POSTGRES_DB=tolk
POSTGRES_USER=tolk
# Letters and digits only (it is embedded in a URL). e.g.: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=

# For running without Docker (local dev). Defaults to SQLite in ./data/tolk.db when unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/tolk

# --- Payments (manual card transfer + receipt upload) -------------------------
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=TOLK Education
# Shown to students/teachers who need help, e.g. @tolk_admin
SUPPORT_CONTACT=@tolk_admin
# Time zone used in Telegram notifications
TIMEZONE=Asia/Tashkent

# --- Demo -------------------------------------------------------------------
# true = seed demo accounts and show one-click demo login. Keep false for real users.
DEMO_MODE=false

# --- Optional tuning ----------------------------------------------------------
# MAX_UPLOAD_MB=5
# SESSION_TTL_DAYS=30
# WEB_WORKERS=2
# MEETING_LINK_HOSTS=zoom.us,meet.google.com,teams.microsoft.com,teams.live.com
